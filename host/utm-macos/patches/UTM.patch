+- (void)port:(CSPort *)port didError:(NSString *)error {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (port == self.dropMetadataPort) {
+            [self clearDropMetadataPortWithDescription:error];
+        }
+    });
+}
+
+- (void)port:(CSPort *)port didRecieveData:(NSData *)data {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (port == self.dropMetadataPort) {
+            [self handleDropMetadataDataOnMainQueue:data];
+        }
+    });
+}
