+- (BOOL)sendFiles:(NSArray<NSURL *> *)urls
+         progress:(UTMSpiceFileTransferProgressHandler)progress
+       completion:(UTMSpiceFileTransferCompletionHandler)completion {
+    CSConnection *connection = self.spiceConnection;
+    if (!self.isConnected || !connection) {
+        NSError *error = [NSError errorWithDomain:kUTMErrorDomain
+                                             code:-1
+                                         userInfo:@{ NSLocalizedDescriptionKey: NSLocalizedString(@"The SPICE connection is not available.", @"UTMSpiceIO") }];
+        dispatch_async(dispatch_get_main_queue(), ^{
+            completion(error);
+        });
+        return NO;
+    }
+
+    NSMutableArray<NSURL *> *scopedURLs = [NSMutableArray array];
+    NSError *validationError = nil;
+    for (NSURL *url in urls) {
+        if (url.isFileURL && [url startAccessingSecurityScopedResource]) {
+            [scopedURLs addObject:url];
+        }
+
+        NSNumber *isRegularFile = nil;
+        NSError *resourceError = nil;
+        BOOL hasResourceValue = url.isFileURL &&
+            [url getResourceValue:&isRegularFile forKey:NSURLIsRegularFileKey error:&resourceError];
+        if (!hasResourceValue || !isRegularFile.boolValue ||
+            ![NSFileManager.defaultManager isReadableFileAtPath:url.path]) {
+            NSString *description = [NSString stringWithFormat:NSLocalizedString(@"“%@” is not a readable regular file.", @"UTMSpiceIO"), url.lastPathComponent];
+            NSMutableDictionary *userInfo = [@{ NSLocalizedDescriptionKey: description } mutableCopy];
+            if (resourceError) {
+                userInfo[NSUnderlyingErrorKey] = resourceError;
+            }
+            validationError = [NSError errorWithDomain:kUTMErrorDomain
+                                                   code:-1
+                                               userInfo:userInfo];
+            break;
+        }
+    }
+
+    if (urls.count == 0 && !validationError) {
+        validationError = [NSError errorWithDomain:kUTMErrorDomain
+                                               code:-1
+                                           userInfo:@{ NSLocalizedDescriptionKey: NSLocalizedString(@"No files were selected for transfer.", @"UTMSpiceIO") }];
+    }
+
+    if (validationError) {
+        for (NSURL *url in scopedURLs) {
+            [url stopAccessingSecurityScopedResource];
+        }
+        dispatch_async(dispatch_get_main_queue(), ^{
+            completion(validationError);
+        });
+        return NO;
+    }
+
+    UTMLog(@"starting SPICE file transfer for %lu file(s)", (unsigned long)urls.count);
+    __weak typeof(self) weakSelf = self;
+    __block __weak CSFileTransfer *weakTransfer = nil;
+    CSFileTransfer *transfer = [connection transferFiles:urls
+                                                progress:progress
+                                              completion:^(NSError *error) {
+        for (NSURL *url in scopedURLs) {
+            [url stopAccessingSecurityScopedResource];
+        }
+        typeof(self) self = weakSelf;
+        if (self) {
+            @synchronized (self.activeFileTransfers) {
+                [self.activeFileTransfers removeObject:weakTransfer];
+            }
+        }
+        if (error) {
+            UTMLog(@"SPICE file transfer failed: %@", error.localizedDescription);
+        } else {
+            UTMLog(@"SPICE file transfer completed");
+        }
+        completion(error);
+    }];
+    weakTransfer = transfer;
+    if (transfer) {
+        @synchronized (self.activeFileTransfers) {
+            [self.activeFileTransfers addObject:transfer];
+        }
+    }
+    return transfer != nil;
+}
