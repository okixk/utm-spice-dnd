+- (BOOL)isDropMetadataAvailable {
+    NSAssert(NSThread.isMainThread, @"Drop metadata state must be read on the main thread.");
+    return self.dropMetadataPort != nil && self.dropMetadataPort.isOpen;
+}
+
+- (NSError *)dropMetadataErrorWithDescription:(NSString *)description {
+    return [NSError errorWithDomain:kUTMErrorDomain
+                               code:-1
+                           userInfo:@{ NSLocalizedDescriptionKey: description }];
+}
+
+- (void)clearDropMetadataPortWithDescription:(NSString *)description {
+    NSAssert(NSThread.isMainThread, @"Drop metadata state must be changed on the main thread.");
+    self.dropMetadataPort.delegate = nil;
+    self.dropMetadataPort = nil;
+    self.dropMetadataBuffer.length = 0;
+    self.dropMetadataDiscardingOversizedMessage = NO;
+    NSDictionary<NSString *, UTMSpiceDropMetadataCompletionHandler> *completions = self.dropMetadataCompletions.copy;
+    [self.dropMetadataCompletions removeAllObjects];
+    NSError *error = [self dropMetadataErrorWithDescription:description];
+    for (UTMSpiceDropMetadataCompletionHandler completion in completions.allValues) {
+        completion(nil, error);
+    }
+}
+
+- (BOOL)sendDropMetadata:(NSDictionary *)metadata
+              completion:(UTMSpiceDropMetadataCompletionHandler)completion {
+    NSAssert(NSThread.isMainThread, @"Drop metadata must be sent from the main thread.");
+    CSPort *port = self.dropMetadataPort;
+    NSString *transferIdentifier = metadata[@"transferId"];
+    NSUUID *uuid = [transferIdentifier isKindOfClass:NSString.class] ? [[NSUUID alloc] initWithUUIDString:transferIdentifier] : nil;
+    transferIdentifier = uuid.UUIDString.lowercaseString;
+    if (!self.isConnected || !port || !port.isOpen || !transferIdentifier) {
+        return NO;
+    }
+
+    NSError *serializationError = nil;
+    NSData *json = [NSJSONSerialization dataWithJSONObject:metadata options:0 error:&serializationError];
+    if (!json || json.length + 1 > kUTMDropMaximumMessageSize) {
+        UTMLog(@"failed to serialize drag-and-drop metadata: %@", serializationError.localizedDescription);
+        return NO;
+    }
+    if (self.dropMetadataCompletions[transferIdentifier]) {
+        UTMLog(@"duplicate drag-and-drop metadata identifier: %@", transferIdentifier);
+        return NO;
+    }
+
+    NSMutableData *message = [json mutableCopy];
+    const uint8_t newline = '\n';
+    [message appendBytes:&newline length:1];
+    self.dropMetadataCompletions[transferIdentifier] = [completion copy];
+    [port writeData:message];
+    UTMLog(@"drag-and-drop metadata queued: port=%@ id=%@ version=%@ display=%@ guest=(%@,%@) framebuffer=(%@,%@) files=%lu bytes=%lu",
+           port.name, transferIdentifier, metadata[@"version"], metadata[@"display"], metadata[@"x"], metadata[@"y"],
+           metadata[@"framebufferWidth"], metadata[@"framebufferHeight"],
+           (unsigned long)[metadata[@"files"] count], (unsigned long)message.length);
+
+    __weak typeof(self) weakSelf = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(kUTMDropResponseTimeout * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        typeof(self) self = weakSelf;
+        UTMSpiceDropMetadataCompletionHandler pending = self.dropMetadataCompletions[transferIdentifier];
+        if (pending) {
+            [self.dropMetadataCompletions removeObjectForKey:transferIdentifier];
+            UTMLog(@"drag-and-drop metadata timed out: id=%@", transferIdentifier);
+            pending(nil, [self dropMetadataErrorWithDescription:NSLocalizedString(@"The guest drag-and-drop helper did not respond.", @"UTMSpiceIO")]);
+        }
+    });
+    return YES;
+}
+
+- (void)cancelDropMetadataTransfer:(NSString *)transferIdentifier {
+    NSAssert(NSThread.isMainThread, @"Drop metadata must be sent from the main thread.");
+    CSPort *port = self.dropMetadataPort;
+    if (!port || !port.isOpen || transferIdentifier.length == 0) {
+        return;
+    }
+    NSDictionary *payload = @{ @"type": @"cancel", @"version": @(kUTMDropProtocolVersion), @"transferId": transferIdentifier };
+    NSData *json = [NSJSONSerialization dataWithJSONObject:payload options:0 error:nil];
+    if (json) {
+        NSMutableData *message = [json mutableCopy];
+        const uint8_t newline = '\n';
+        [message appendBytes:&newline length:1];
+        [port writeData:message];
+        UTMLog(@"drag-and-drop cancellation queued: id=%@", transferIdentifier);
+    }
+}
+
+- (void)handleDropMetadataDataOnMainQueue:(NSData *)data {
+    NSAssert(NSThread.isMainThread, @"Drop metadata must be parsed on the main thread.");
+    if (self.dropMetadataDiscardingOversizedMessage) {
+        const uint8_t newline = '\n';
+        NSData *delimiter = [NSData dataWithBytes:&newline length:1];
+        NSRange range = [data rangeOfData:delimiter options:0 range:NSMakeRange(0, data.length)];
+        if (range.location == NSNotFound) {
+            return;
+        }
+        self.dropMetadataDiscardingOversizedMessage = NO;
+        data = [data subdataWithRange:NSMakeRange(NSMaxRange(range), data.length - NSMaxRange(range))];
+    }
+    [self.dropMetadataBuffer appendData:data];
+
+    const uint8_t newline = '\n';
+    NSData *delimiter = [NSData dataWithBytes:&newline length:1];
+    while (self.dropMetadataBuffer.length > 0) {
+        NSRange range = [self.dropMetadataBuffer rangeOfData:delimiter
+                                                    options:0
+                                                      range:NSMakeRange(0, self.dropMetadataBuffer.length)];
+        if (range.location == NSNotFound) {
+            break;
+        }
+        NSData *line = [self.dropMetadataBuffer subdataWithRange:NSMakeRange(0, range.location)];
+        [self.dropMetadataBuffer replaceBytesInRange:NSMakeRange(0, NSMaxRange(range)) withBytes:NULL length:0];
+        if (line.length == 0) {
+            continue;
+        }
+        if (line.length + 1 > kUTMDropMaximumMessageSize) {
+            UTMLog(@"rejected oversized response from drag-and-drop guest helper");
+            continue;
+        }
+        NSError *jsonError = nil;
+        NSDictionary *response = [NSJSONSerialization JSONObjectWithData:line options:0 error:&jsonError];
+        if (![response isKindOfClass:NSDictionary.class]) {
+            UTMLog(@"invalid response from drag-and-drop guest helper: %@", jsonError.localizedDescription);
+            continue;
+        }
+        NSNumber *version = response[@"version"];
+        NSString *rawTransferIdentifier = response[@"transferId"];
+        NSString *type = response[@"type"];
+        BOOL versionIsBoolean = [version isKindOfClass:NSNumber.class] && CFGetTypeID((__bridge CFTypeRef)version) == CFBooleanGetTypeID();
+        NSUUID *uuid = [rawTransferIdentifier isKindOfClass:NSString.class] ? [[NSUUID alloc] initWithUUIDString:rawTransferIdentifier] : nil;
+        NSString *transferIdentifier = uuid.UUIDString.lowercaseString;
+        if (![version isKindOfClass:NSNumber.class] || versionIsBoolean || version.integerValue != kUTMDropProtocolVersion ||
+            ![type isKindOfClass:NSString.class] || !transferIdentifier) {
+            UTMLog(@"rejected malformed drag-and-drop guest helper response");
+            continue;
+        }
+        UTMSpiceDropMetadataCompletionHandler completion = self.dropMetadataCompletions[transferIdentifier];
+        if (completion && ([type isEqualToString:@"ready"] || [type isEqualToString:@"error"])) {
+            if ([type isEqualToString:@"ready"] && ![response[@"target"] isKindOfClass:NSDictionary.class]) {
+                UTMLog(@"rejected ready response without a valid target: id=%@", transferIdentifier);
+                continue;
+            }
+            if ([type isEqualToString:@"error"] && ![response[@"error"] isKindOfClass:NSString.class]) {
+                UTMLog(@"rejected error response without a valid description: id=%@", transferIdentifier);
+                continue;
+            }
+            [self.dropMetadataCompletions removeObjectForKey:transferIdentifier];
+            if ([type isEqualToString:@"ready"]) {
+                UTMLog(@"drag-and-drop guest helper ready: id=%@ target=%@", transferIdentifier, response[@"target"]);
+                completion(response, nil);
+            } else {
+                NSString *description = response[@"error"];
+                UTMLog(@"drag-and-drop guest helper rejected request: id=%@ error=%@", transferIdentifier, description);
+                completion(response, [self dropMetadataErrorWithDescription:description]);
+            }
+        } else if ([type isEqualToString:@"complete"] || [type isEqualToString:@"error"]) {
+            UTMLog(@"drag-and-drop guest helper status: %@", response);
+        } else {
+            UTMLog(@"ignored unexpected drag-and-drop guest helper response: type=%@ id=%@", type, transferIdentifier);
+        }
+    }
+    if (self.dropMetadataBuffer.length >= kUTMDropMaximumMessageSize) {
+        UTMLog(@"discarding oversized unterminated response from drag-and-drop guest helper");
+        self.dropMetadataBuffer.length = 0;
+        self.dropMetadataDiscardingOversizedMessage = YES;
+    }
+}
