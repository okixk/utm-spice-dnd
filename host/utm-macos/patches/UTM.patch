+// MARK: - Host file transfer
+
+private enum VMFileDropError: LocalizedError {
+    case noFiles
+    case unavailable
+    case unsupportedFile(String)
+    case outsideDisplay
+    case transferInProgress
+
+    var errorDescription: String? {
+        switch self {
+        case .noFiles:
+            return NSLocalizedString("No files were selected for transfer.", comment: "VMDisplayQemuMetalWindowController")
+        case .unavailable:
+            return NSLocalizedString("The SPICE connection is not available.", comment: "VMDisplayQemuMetalWindowController")
+        case .unsupportedFile(let name):
+            return String.localizedStringWithFormat(NSLocalizedString("“%@” is not a readable regular file.", comment: "VMDisplayQemuMetalWindowController"), name)
+        case .outsideDisplay:
+            return NSLocalizedString("The file must be dropped inside the guest display.", comment: "VMDisplayQemuMetalWindowController")
+        case .transferInProgress:
+            return NSLocalizedString("Another target-aware file transfer is already in progress.", comment: "VMDisplayQemuMetalWindowController")
+        }
+    }
+}
+
+extension VMDisplayQemuMetalWindowController: VMMetalViewFileDropDelegate {
+    private var isDropDebugEnabled: Bool {
+        ProcessInfo.processInfo.environment["UTM_DND_DEBUG"] == "1"
+    }
+
+    private func validatedFileURLs(_ urls: [URL]) throws -> [URL] {
+        guard !urls.isEmpty else {
+            throw VMFileDropError.noFiles
+        }
+
+        var validatedURLs = [URL]()
+        for url in urls {
+            guard url.isFileURL,
+                  let values = try? url.resourceValues(forKeys: [.isRegularFileKey]),
+                  values.isRegularFile == true,
+                  FileManager.default.isReadableFile(atPath: url.path) else {
+                throw VMFileDropError.unsupportedFile(url.lastPathComponent)
+            }
+            validatedURLs.append(url)
+        }
+        return validatedURLs
+    }
+
+    private func guestDropPoint(from viewPoint: CGPoint, in metalView: VMMetalView) -> CGPoint? {
+        guard let vmDisplay,
+              displaySize.width > 0,
+              displaySize.height > 0,
+              vmDisplay.viewportScale > 0 else {
+            return nil
+        }
+
+        let backingPoint = metalView.convertToBacking(viewPoint)
+        let drawableSize = metalView.drawableSize
+        let renderedSize = CGSize(width: displaySize.width * vmDisplay.viewportScale,
+                                  height: displaySize.height * vmDisplay.viewportScale)
+        let origin = CGPoint(x: (drawableSize.width - renderedSize.width) / 2,
+                             y: (drawableSize.height - renderedSize.height) / 2)
+        let guestX = (backingPoint.x - origin.x) / vmDisplay.viewportScale
+        let guestY = (drawableSize.height - backingPoint.y - origin.y) / vmDisplay.viewportScale
+        guard guestX >= 0,
+              guestY >= 0,
+              guestX < displaySize.width,
+              guestY < displaySize.height else {
+            return nil
+        }
+        return CGPoint(x: guestX, y: guestY)
+    }
+
+    func metalView(_ metalView: VMMetalView, canAcceptFileURLs urls: [URL], at point: CGPoint) -> Bool {
+        guard vm.state == .started,
+              qemuVM.ioService?.isConnected == true,
+              guestDropPoint(from: point, in: metalView) != nil,
+              !isSemanticFileTransferActive else {
+            return false
+        }
+        return (try? validatedFileURLs(urls)) != nil
+    }
+
+    func metalView(_ metalView: VMMetalView, performFileDropWith urls: [URL], at viewPoint: CGPoint) -> Bool {
+        do {
+            let urls = try validatedFileURLs(urls)
+            guard vm.state == .started,
+                  let ioService = qemuVM.ioService,
+                  ioService.isConnected else {
+                throw VMFileDropError.unavailable
+            }
+            guard !isSemanticFileTransferActive else {
+                throw VMFileDropError.transferInProgress
+            }
+            guard let guestPoint = guestDropPoint(from: viewPoint, in: metalView),
+                  let vmDisplay else {
+                throw VMFileDropError.outsideDisplay
+            }
+
+            let files: [[String: Any]] = try urls.map { url in
+                let values = try url.resourceValues(forKeys: [.fileSizeKey])
+                guard let size = values.fileSize else {
+                    throw VMFileDropError.unsupportedFile(url.lastPathComponent)
+                }
+                return ["name": url.lastPathComponent, "size": size]
+            }
+            let transferIdentifier = UUID().uuidString.lowercased()
+            let metadata: [String: Any] = [
+                "type": "drop",
+                "version": 1,
+                "transferId": transferIdentifier,
+                "display": vmDisplay.monitorID,
+                "x": guestPoint.x,
+                "y": guestPoint.y,
+                "framebufferWidth": displaySize.width,
+                "framebufferHeight": displaySize.height,
+                "files": files,
+            ]
+
+            if isDropDebugEnabled {
+                logger.info("UTM drop: view=(\(viewPoint.x), \(viewPoint.y)) guest=(\(guestPoint.x), \(guestPoint.y)) display=\(vmDisplay.monitorID)")
+            }
+
+            let startTransfer: () -> Bool = { [weak self, weak ioService] in
+                guard let self, let ioService else {
+                    return false
+                }
+                self.isSemanticFileTransferActive = true
+                logger.info("Starting SPICE transfer of \(urls.count) host file(s), id=\(transferIdentifier).")
+                let started = ioService.sendFiles(urls, progress: nil) { [weak self, weak ioService] error in
+                    self?.isSemanticFileTransferActive = false
+                    if let error {
+                        ioService?.cancelDropMetadataTransfer(transferIdentifier)
+                        logger.error("SPICE file transfer failed: \(error.localizedDescription)")
+                        self?.showErrorAlert(error.localizedDescription)
+                    } else {
+                        logger.info("SPICE file transfer completed, id=\(transferIdentifier).")
+                    }
+                }
+                if !started {
+                    self.isSemanticFileTransferActive = false
+                }
+                return started
+            }
+
+            if ioService.isDropMetadataAvailable {
+                isSemanticFileTransferActive = true
+                let accepted = ioService.sendDropMetadata(metadata) { [weak self] response, error in
+                    guard let self else {
+                        return
+                    }
+                    self.isSemanticFileTransferActive = false
+                    if let error {
+                        logger.warning("Target-aware guest helper unavailable (\(error.localizedDescription)); using Downloads fallback.")
+                        _ = startTransfer()
+                        return
+                    }
+                    if self.isDropDebugEnabled,
+                       let target = response?["target"] {
+                        logger.info("Guest target: \(String(describing: target))")
+                    }
+                    _ = startTransfer()
+                }
+                if accepted {
+                    return true
+                }
+                isSemanticFileTransferActive = false
+            }
+
+            logger.debug("Target-aware guest helper is unavailable; using Downloads fallback.")
+            return startTransfer()
+        } catch {
+            logger.error("Rejected host file drop: \(error.localizedDescription)")
+            showErrorAlert(error.localizedDescription)
+            return false
+        }
+    }
+}
