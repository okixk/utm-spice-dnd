+- (void)portDidDisconect:(CSPort *)port {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (port == self.dropMetadataPort) {
+            [self clearDropMetadataPortWithDescription:NSLocalizedString(@"The guest drag-and-drop helper disconnected.", @"UTMSpiceIO")];
