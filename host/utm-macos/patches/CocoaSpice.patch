+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+FOUNDATION_EXPORT NSErrorDomain const CSFileTransferErrorDomain;
+
+typedef NS_ERROR_ENUM(CSFileTransferErrorDomain, CSFileTransferError) {
+    CSFileTransferErrorInvalidSource = 1,
+    CSFileTransferErrorNotConnected,
+    CSFileTransferErrorAgentUnavailable,
+    CSFileTransferErrorUnsupported,
+    CSFileTransferErrorFailed,
+    CSFileTransferErrorCancelled,
+};
+
+typedef void (^CSFileTransferProgressHandler)(uint64_t completed, uint64_t total);
+typedef void (^CSFileTransferCompletionHandler)(NSError * _Nullable error);
+
+/// Represents one host-to-guest SPICE file transfer operation.
+///
+/// Progress and completion callbacks are always delivered on the main queue.
+@interface CSFileTransfer : NSObject
+
+/// Whether cancellation has been requested.
+@property (nonatomic, readonly, getter=isCancelled) BOOL cancelled;
+
+/// Whether the operation has finished and queued its completion callback.
+@property (nonatomic, readonly, getter=isFinished) BOOL finished;
+
+- (instancetype)init NS_UNAVAILABLE;
+
+/// Request cancellation. This method is safe to call from any thread.
+- (void)cancel;
+
+@end
+
+NS_ASSUME_NONNULL_END
