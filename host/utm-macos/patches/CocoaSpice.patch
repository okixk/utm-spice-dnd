+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//
+
+#import "CSFileTransfer+Protected.h"
+#import <glib.h>
+#import <spice-client.h>
+#import <spice/vd_agent.h>
+
+NSErrorDomain const CSFileTransferErrorDomain = @"com.utmapp.CocoaSpice.FileTransfer";
+
+@interface CSFileTransfer ()
+
+@property (nonatomic, copy) NSArray<NSURL *> *urls;
+@property (nonatomic, nullable, copy) CSFileTransferProgressHandler progressHandler;
+@property (nonatomic, nullable, copy) CSFileTransferCompletionHandler completionHandler;
+@property (nonatomic, nullable, copy) CSFileTransferCleanupHandler cleanupHandler;
+
+@end
+
+
+@implementation CSFileTransfer {
+    SpiceMainChannel *_mainChannel;
+    GCancellable *_cancellable;
+    BOOL _cancelled;
+    BOOL _finished;
+    BOOL _progressDispatchPending;
+    uint64_t _latestCompleted;
+    uint64_t _latestTotal;
+}
+
+static NSError *cs_file_transfer_error(CSFileTransferError code, NSString *description) {
+    return [NSError errorWithDomain:CSFileTransferErrorDomain
+                               code:code
+                           userInfo:@{ NSLocalizedDescriptionKey: description }];
+}
+
+static NSError *cs_file_transfer_error_from_gerror(const GError *error) {
+    if (g_error_matches(error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) {
+        return cs_file_transfer_error(CSFileTransferErrorCancelled,
+                                      NSLocalizedString(@"The file transfer was cancelled.", @"CSFileTransfer"));
+    }
+
+    NSString *description = error->message ? [NSString stringWithUTF8String:error->message] : nil;
+    if (!description) {
+        description = NSLocalizedString(@"The file transfer failed.", @"CSFileTransfer");
+    }
+
+    const gchar *domainName = g_quark_to_string(error->domain);
+    NSString *underlyingDomain = domainName ? [NSString stringWithUTF8String:domainName] : CSFileTransferErrorDomain;
+    NSError *underlyingError = [NSError errorWithDomain:underlyingDomain
+                                                   code:error->code
+                                               userInfo:@{ NSLocalizedDescriptionKey: description }];
+    return [NSError errorWithDomain:CSFileTransferErrorDomain
+                               code:CSFileTransferErrorFailed
+                           userInfo:@{ NSLocalizedDescriptionKey: description,
+                                       NSUnderlyingErrorKey: underlyingError }];
+}
+
+- (instancetype)initWithURLs:(NSArray<NSURL *> *)urls
+              progressHandler:(CSFileTransferProgressHandler)progressHandler
+           completionHandler:(CSFileTransferCompletionHandler)completionHandler
+              cleanupHandler:(CSFileTransferCleanupHandler)cleanupHandler {
+    self = [super init];
+    if (self) {
+        self.urls = [urls copy];
+        self.progressHandler = progressHandler;
+        self.completionHandler = completionHandler;
+        self.cleanupHandler = cleanupHandler;
+    }
+    return self;
+}
+
+- (BOOL)isCancelled {
+    @synchronized (self) {
+        return _cancelled;
+    }
+}
+
+- (BOOL)isFinished {
+    @synchronized (self) {
+        return _finished;
+    }
+}
+
+- (void)cancel {
+    GCancellable *cancellable = NULL;
+    @synchronized (self) {
+        if (_finished) {
+            return;
+        }
+        _cancelled = YES;
+        if (_cancellable) {
+            cancellable = g_object_ref(_cancellable);
+        }
+    }
+    if (cancellable) {
+        g_cancellable_cancel(cancellable);
+        g_object_unref(cancellable);
+    }
+}
+
+- (void)dispatchProgressCompleted:(uint64_t)completed total:(uint64_t)total {
+    @synchronized (self) {
+        if (_finished || !self.progressHandler) {
+            return;
+        }
+        _latestCompleted = completed;
+        _latestTotal = total;
+        if (_progressDispatchPending) {
+            return;
+        }
+        _progressDispatchPending = YES;
+    }
+
+    dispatch_async(dispatch_get_main_queue(), ^{
+        CSFileTransferProgressHandler progressHandler;
+        uint64_t latestCompleted;
+        uint64_t latestTotal;
+        @synchronized (self) {
+            self->_progressDispatchPending = NO;
+            progressHandler = self.progressHandler;
+            latestCompleted = self->_latestCompleted;
+            latestTotal = self->_latestTotal;
+        }
+        if (progressHandler) {
+            progressHandler(latestCompleted, latestTotal);
+        }
+    });
+}
+
+- (void)finishOnWorkerWithError:(nullable NSError *)error {
+    SpiceMainChannel *mainChannel = NULL;
+    GCancellable *cancellable = NULL;
+    @synchronized (self) {
+        if (_finished) {
+            return;
+        }
+        _finished = YES;
+        mainChannel = _mainChannel;
+        _mainChannel = NULL;
+        cancellable = _cancellable;
+        _cancellable = NULL;
+    }
+
+    if (cancellable) {
+        g_object_unref(cancellable);
+    }
+    if (mainChannel) {
+        g_object_unref(mainChannel);
+    }
+
+    dispatch_async(dispatch_get_main_queue(), ^{
+        CSFileTransferCleanupHandler cleanupHandler = self.cleanupHandler;
+        CSFileTransferCompletionHandler completionHandler = self.completionHandler;
+        self.cleanupHandler = nil;
+        self.completionHandler = nil;
+        self.progressHandler = nil;
+        cleanupHandler(self);
+        completionHandler(error);
+    });
+}
+
+static void cs_file_transfer_progress(goffset currentNumBytes,
+                                      goffset totalNumBytes,
+                                      gpointer userData) {
+    CSFileTransfer *self = (__bridge CSFileTransfer *)userData;
+    [self dispatchProgressCompleted:(uint64_t)MAX(currentNumBytes, 0)
+                              total:(uint64_t)MAX(totalNumBytes, 0)];
+}
+
+static void cs_file_transfer_complete(GObject *sourceObject,
+                                      GAsyncResult *result,
+                                      gpointer userData) {
+    CSFileTransfer *self = (__bridge_transfer CSFileTransfer *)userData;
+    GError *error = NULL;
+    gboolean success = spice_main_channel_file_copy_finish(SPICE_MAIN_CHANNEL(sourceObject),
+                                                            result,
+                                                            &error);
+    NSError *nsError = nil;
+    if (!success) {
+        if (self.isCancelled) {
+            nsError = cs_file_transfer_error(CSFileTransferErrorCancelled,
+                                              NSLocalizedString(@"The file transfer was cancelled.", @"CSFileTransfer"));
+        } else if (error) {
+            nsError = cs_file_transfer_error_from_gerror(error);
+        } else {
+            nsError = cs_file_transfer_error(CSFileTransferErrorFailed,
+                                              NSLocalizedString(@"The file transfer failed.", @"CSFileTransfer"));
+        }
+    }
+    g_clear_error(&error);
+    [self finishOnWorkerWithError:nsError];
+}
+
+- (void)startWithMainChannel:(SpiceMainChannel *)mainChannel {
+    NSParameterAssert(!mainChannel || SPICE_IS_MAIN_CHANNEL(mainChannel));
+
+    if (self.isCancelled) {
+        [self finishOnWorkerWithError:cs_file_transfer_error(CSFileTransferErrorCancelled,
+                                                              NSLocalizedString(@"The file transfer was cancelled.", @"CSFileTransfer"))];
+        return;
+    }
+    if (!mainChannel) {
+        [self finishOnWorkerWithError:cs_file_transfer_error(CSFileTransferErrorNotConnected,
+                                                              NSLocalizedString(@"The SPICE connection is not available.", @"CSFileTransfer"))];
+        return;
+    }
+
+    gboolean agentConnected = FALSE;
+    g_object_get(mainChannel, "agent-connected", &agentConnected, NULL);
+    if (!agentConnected) {
+        [self finishOnWorkerWithError:cs_file_transfer_error(CSFileTransferErrorAgentUnavailable,
+                                                              NSLocalizedString(@"The SPICE guest agent is not connected.", @"CSFileTransfer"))];
+        return;
+    }
+    if (spice_main_channel_agent_test_capability(mainChannel, VD_AGENT_CAP_FILE_XFER_DISABLED)) {
+        [self finishOnWorkerWithError:cs_file_transfer_error(CSFileTransferErrorUnsupported,
+                                                              NSLocalizedString(@"File transfer is disabled by the SPICE guest agent.", @"CSFileTransfer"))];
+        return;
+    }
+
+    GFile **files = g_new0(GFile *, self.urls.count + 1);
+    for (NSUInteger index = 0; index < self.urls.count; index++) {
+        files[index] = g_file_new_for_path(self.urls[index].fileSystemRepresentation);
+    }
+
+    @synchronized (self) {
+        if (_cancelled) {
+            for (NSUInteger index = 0; index < self.urls.count; index++) {
+                g_object_unref(files[index]);
+            }
+            g_free(files);
+            [self finishOnWorkerWithError:cs_file_transfer_error(CSFileTransferErrorCancelled,
+                                                                  NSLocalizedString(@"The file transfer was cancelled.", @"CSFileTransfer"))];
+            return;
+        }
+
+        _mainChannel = g_object_ref(mainChannel);
+        _cancellable = g_cancellable_new();
+
+        // spice-gtk creates and retains every per-file task synchronously in
+        // this call. Keep cancellation serialized until that has happened so
+        // an already-cancelled GCancellable cannot produce an empty operation
+        // which would have no task available to deliver completion.
+        spice_main_channel_file_copy_async(mainChannel,
+                                           files,
+                                           G_FILE_COPY_NONE,
+                                           _cancellable,
+                                           cs_file_transfer_progress,
+                                           (__bridge gpointer)self,
+                                           cs_file_transfer_complete,
+                                           (__bridge_retained gpointer)self);
+    }
+
+    for (NSUInteger index = 0; index < self.urls.count; index++) {
+        g_object_unref(files[index]);
+    }
+    g_free(files);
+}
+
+@end
