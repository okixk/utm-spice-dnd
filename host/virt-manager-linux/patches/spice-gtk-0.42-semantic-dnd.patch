+static void test_coordinate_transform(void)
+{
+    gint x;
+    gint y;
+
+    g_assert_true(semantic_dnd_transform_input(1280, 720, 0, 59, 500, 281,
+                                               1, 250, 60, &x, &y));
+    g_assert_cmpint(x, ==, 640);
+    g_assert_cmpint(y, ==, 2);
+
+    g_assert_true(semantic_dnd_transform_input(1280, 720, 0, 119, 1000, 563,
+                                               1, 999, 399, &x, &y));
+    g_assert_cmpint(x, ==, 1279);
+    g_assert_cmpint(y, >=, 0);
+
+    /* Preserve upstream's integer division of odd physical offsets. */
+    g_assert_true(semantic_dnd_transform_input(1280, 720, 3, 119, 1000, 563,
+                                               2, 1, 59, &x, &y));
+    g_assert_cmpint(x, ==, 0);
+    g_assert_cmpint(y, ==, 0);
+
+    g_assert_false(semantic_dnd_transform_input(0, 720, 0, 0, 100, 100,
+                                                1, 0, 0, &x, &y));
+}
