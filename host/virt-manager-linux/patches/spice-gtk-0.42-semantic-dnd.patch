+static void semantic_send_cancel(SpiceDisplay *display, const gchar *reason)
+{
+    SemanticDndState *state = semantic_dnd_state(display, FALSE);
+    SemanticDrop *drop;
+    gchar *message;
+
+    if (state == NULL || state->active == NULL ||
+        state->active->protocol.phase != SEMANTIC_DND_PHASE_WAITING_CANCEL)
+        return;
+    drop = state->active;
+    if (drop->timeout_source != 0) {
+        g_source_remove(drop->timeout_source);
+        drop->timeout_source = 0;
+    }
+    g_warning("Semantic DnD metadata %s; requesting cancellation before fallback",
+              reason);
+    message = g_strdup_printf("{\"type\":\"cancel\",\"version\":%d,"
+                              "\"transferId\":\"%s\"}\n",
+                              SEMANTIC_DND_PROTOCOL_VERSION,
+                              drop->transfer_id);
+    drop->timeout_source = g_timeout_add_full(G_PRIORITY_DEFAULT,
+                                              SEMANTIC_DND_CANCEL_TIMEOUT_MS,
+                                              semantic_metadata_timeout,
+                                              g_object_ref(display),
+                                              g_object_unref);
+    semantic_port_write(display, message, drop->transfer_id, FALSE, TRUE);
+    g_free(message);
+}
