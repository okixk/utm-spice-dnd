+    g_assert_cmpint(semantic_dnd_protocol_complete(&state, SEMANTIC_REPLY_COMPLETE),
+                    ==, SEMANTIC_DND_ACTION_NONE);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_TRANSFERRING);
+    g_assert_cmpint(semantic_dnd_protocol_payload_finished(&state, TRUE),
+                    ==, SEMANTIC_DND_ACTION_FINISH);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_DONE);
+}
+
+static void test_complete_timeout_and_disconnect_fail_closed(void)
+{
+    SemanticDndProtocolState state;
+
+    semantic_dnd_protocol_init(&state, TRUE);
+    semantic_dnd_protocol_ready(&state);
+    semantic_dnd_protocol_payload_finished(&state, TRUE);
+    g_assert_cmpint(semantic_dnd_protocol_timeout(&state),
+                    ==, SEMANTIC_DND_ACTION_FAIL_CLOSED);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_FAILED);
+
+    semantic_dnd_protocol_init(&state, TRUE);
+    semantic_dnd_protocol_ready(&state);
+    semantic_dnd_protocol_payload_finished(&state, TRUE);
+    g_assert_cmpint(semantic_dnd_protocol_complete(&state, SEMANTIC_REPLY_ERROR),
+                    ==, SEMANTIC_DND_ACTION_FAIL_CLOSED);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_FAILED);
+
+    semantic_dnd_protocol_init(&state, TRUE);
+    semantic_dnd_protocol_ready(&state);
+    semantic_dnd_protocol_payload_finished(&state, TRUE);
+    g_assert_cmpint(semantic_dnd_protocol_disconnect(&state),
+                    ==, SEMANTIC_DND_ACTION_FAIL_CLOSED);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_FAILED);
+}
