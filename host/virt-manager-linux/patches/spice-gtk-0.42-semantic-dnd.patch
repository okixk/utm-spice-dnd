+++ b/src/semantic-dnd.c	2026-09-11 07:46:18.135567599 +0200
@@ -0,0 +1,414 @@
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+#include <json-glib/json-glib.h>
+
+#include "semantic-dnd.h"
+
+#define SEMANTIC_DND_PROTOCOL_VERSION 1
+
+typedef struct {
+    GHashTable *members;
+    gboolean duplicate;
+} MemberValidation;
+
+static void member_seen(JsonParser *parser G_GNUC_UNUSED,
+                        JsonObject *object, const gchar *member,
+                        gpointer user_data)
+{
+    MemberValidation *validation = user_data;
+    gchar *key = g_strdup_printf("%p:%s", (void *)object, member);
+
+    if (g_hash_table_contains(validation->members, key))
+        validation->duplicate = TRUE;
+    g_hash_table_add(validation->members, key);
+}
+
+static gboolean depth_valid(const gchar *line, gsize length)
+{
+    guint depth = 0;
+    gboolean string = FALSE;
+    gboolean escaped = FALSE;
+    gsize i;
+
+    for (i = 0; i < length; i++) {
+        if (string) {
+            if (escaped)
+                escaped = FALSE;
+            else if (line[i] == '\\')
+                escaped = TRUE;
+            else if (line[i] == '"')
+                string = FALSE;
+        } else if (line[i] == '"') {
+            string = TRUE;
+        } else if (line[i] == '{' || line[i] == '[') {
+            if (++depth > 32)
+                return FALSE;
+        } else if (line[i] == '}' || line[i] == ']') {
+            if (depth == 0)
+                return FALSE;
+            depth--;
+        }
+    }
+    return !string && depth == 0;
+}
+
+static gboolean exact_members(JsonObject *object,
+                              const gchar *const *members,
+                              guint n_members)
+{
+    guint i;
+
+    if (json_object_get_size(object) != n_members)
+        return FALSE;
+    for (i = 0; i < n_members; i++) {
+        if (!json_object_has_member(object, members[i]))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static gboolean string_member(JsonObject *object,
+                              const gchar *name,
+                              const gchar **value)
+{
+    JsonNode *node = json_object_get_member(object, name);
+
+    if (node == NULL || !JSON_NODE_HOLDS_VALUE(node) ||
+        json_node_get_value_type(node) != G_TYPE_STRING)
+        return FALSE;
+    *value = json_node_get_string(node);
+    return *value != NULL;
+}
+
+static gboolean version_valid(JsonObject *object)
+{
+    JsonNode *node = json_object_get_member(object, "version");
+    GType type;
+
+    if (node == NULL || !JSON_NODE_HOLDS_VALUE(node))
+        return FALSE;
+    type = json_node_get_value_type(node);
+    if (type != G_TYPE_INT64 && type != G_TYPE_INT && type != G_TYPE_LONG)
+        return FALSE;
+    return json_node_get_int(node) == SEMANTIC_DND_PROTOCOL_VERSION;
+}
+
+static gboolean target_valid(JsonNode *node)
+{
+    static const gchar *const allowed[] = {
+        "kind", "uri", "confidence", "reason", "diagnostic"
+    };
+    JsonObject *target;
+    GList *members;
+    GList *item;
+    const gchar *kind;
+    const gchar *uri;
+    const gchar *confidence;
+    const gchar *reason;
+    guint i;
+    gboolean known;
+
+    if (node == NULL || !JSON_NODE_HOLDS_OBJECT(node))
+        return FALSE;
+    target = json_node_get_object(node);
+    if (json_object_get_size(target) < 3 || json_object_get_size(target) > 5 ||
+        !string_member(target, "kind", &kind) ||
+        !string_member(target, "uri", &uri) ||
+        !string_member(target, "confidence", &confidence) ||
+        (!g_str_equal(kind, "desktop") &&
+         !g_str_equal(kind, "nautilus") &&
+         !g_str_equal(kind, "fallback")) ||
+        !g_str_has_prefix(uri, "file://") || strlen(uri) > 4096 ||
+        (!g_str_equal(confidence, "high") &&
+         !g_str_equal(confidence, "low")))
+        return FALSE;
+
+    if (json_object_has_member(target, "reason") &&
+        (!string_member(target, "reason", &reason) || strlen(reason) > 4096))
+        return FALSE;
+    if (json_object_has_member(target, "diagnostic")) {
+        JsonNode *diagnostic = json_object_get_member(target, "diagnostic");
+
+        if (diagnostic == NULL || !JSON_NODE_HOLDS_OBJECT(diagnostic))
+            return FALSE;
+    }
+
+    members = json_object_get_members(target);
+    for (item = members; item != NULL; item = item->next) {
+        known = FALSE;
+        for (i = 0; i < G_N_ELEMENTS(allowed); i++) {
+            if (g_str_equal(item->data, allowed[i])) {
+                known = TRUE;
+                break;
+            }
+        }
+        if (!known) {
+            g_list_free(members);
+            return FALSE;
+        }
+    }
+    g_list_free(members);
+    return TRUE;
+}
+
+SemanticReply semantic_dnd_validate_reply(const gchar *line,
+                                          gsize line_length,
+                                          const gchar *transfer_id)
+{
+    static const gchar *const ready_members[] = {
+        "type", "version", "transferId", "target"
+    };
+    static const gchar *const error_members[] = {
+        "type", "version", "transferId", "error"
+    };
+    static const gchar *const cancelled_members[] = {
+        "type", "version", "transferId"
+    };
+    static const gchar *const complete_members[] = {
+        "type", "version", "transferId"
+    };
+    JsonParser *parser = json_parser_new();
+    JsonNode *root;
+    JsonObject *object;
+    const gchar *type;
+    const gchar *response_id;
+    const gchar *error_message;
+    SemanticReply reply = SEMANTIC_REPLY_INVALID;
+    MemberValidation validation = {
+        g_hash_table_new_full(g_str_hash, g_str_equal, g_free, NULL), FALSE
+    };
+
+    g_signal_connect(parser, "object-member", G_CALLBACK(member_seen), &validation);
+
+    if (line == NULL || transfer_id == NULL || line_length >= 65536 ||
+        memchr(line, '\0', line_length) != NULL ||
+        !g_utf8_validate(line, line_length, NULL) || !depth_valid(line, line_length) ||
+        g_strstr_len(line, line_length, "\\u0000") != NULL ||
+        !json_parser_load_from_data(parser, line, line_length, NULL) ||
+        validation.duplicate)
+        goto end;
+    root = json_parser_get_root(parser);
+    if (root == NULL || !JSON_NODE_HOLDS_OBJECT(root))
+        goto end;
+    object = json_node_get_object(root);
+    if (!string_member(object, "type", &type) ||
+        !string_member(object, "transferId", &response_id))
+        goto end;
+    if (!g_str_equal(response_id, transfer_id)) {
+        reply = SEMANTIC_REPLY_UNRELATED;
+        goto end;
+    }
+    if (!version_valid(object))
+        goto end;
+
+    if (g_str_equal(type, "ready") &&
+        exact_members(object, ready_members, G_N_ELEMENTS(ready_members)) &&
+        target_valid(json_object_get_member(object, "target"))) {
+        reply = SEMANTIC_REPLY_READY;
+    } else if (g_str_equal(type, "error") &&
+               exact_members(object, error_members, G_N_ELEMENTS(error_members)) &&
+               string_member(object, "error", &error_message) &&
+               error_message[0] != '\0' && strlen(error_message) <= 4096) {
+        reply = SEMANTIC_REPLY_ERROR;
+    } else if (g_str_equal(type, "cancelled") &&
+               exact_members(object, cancelled_members,
+                             G_N_ELEMENTS(cancelled_members))) {
+        reply = SEMANTIC_REPLY_CANCELLED;
+    } else if (g_str_equal(type, "complete") &&
+               exact_members(object, complete_members,
+                             G_N_ELEMENTS(complete_members))) {
+        reply = SEMANTIC_REPLY_COMPLETE;
+    }
+
+end:
+    g_hash_table_unref(validation.members);
+    g_object_unref(parser);
+    return reply;
+}
+
+void semantic_dnd_protocol_init(SemanticDndProtocolState *state,
+                                gboolean semantic)
+{
+    g_return_if_fail(state != NULL);
+
+    *state = (SemanticDndProtocolState) {
+        .phase = semantic ? SEMANTIC_DND_PHASE_WAITING_READY
+                          : SEMANTIC_DND_PHASE_TRANSFERRING,
+        .semantic = semantic,
+    };
+}
+
+SemanticDndProtocolAction semantic_dnd_protocol_ready(
+    SemanticDndProtocolState *state)
+{
+    g_return_val_if_fail(state != NULL, SEMANTIC_DND_ACTION_FAIL_CLOSED);
+
+    if (!state->semantic || state->phase != SEMANTIC_DND_PHASE_WAITING_READY)
+        return SEMANTIC_DND_ACTION_FAIL_CLOSED;
+    state->phase = SEMANTIC_DND_PHASE_TRANSFERRING;
+    return SEMANTIC_DND_ACTION_START_PAYLOAD;
+}
+
+SemanticDndProtocolAction semantic_dnd_protocol_begin_cancel(
+    SemanticDndProtocolState *state, gboolean discard_after_cancel)
+{
+    g_return_val_if_fail(state != NULL, SEMANTIC_DND_ACTION_FAIL_CLOSED);
+
+    if (!state->semantic ||
+        (state->phase != SEMANTIC_DND_PHASE_WAITING_READY &&
+         state->phase != SEMANTIC_DND_PHASE_TRANSFERRING)) {
+        state->phase = SEMANTIC_DND_PHASE_FAILED;
+        return SEMANTIC_DND_ACTION_FAIL_CLOSED;
+    }
+    state->phase = SEMANTIC_DND_PHASE_WAITING_CANCEL;
+    state->discard_after_cancel = discard_after_cancel;
+    state->cancel_write_complete = FALSE;
+    state->cancel_acknowledged = FALSE;
+    return SEMANTIC_DND_ACTION_SEND_CANCEL;
+}
+
+static SemanticDndProtocolAction cancel_barrier_action(
+    SemanticDndProtocolState *state)
+{
+    if (!state->cancel_write_complete || !state->cancel_acknowledged)
+        return SEMANTIC_DND_ACTION_NONE;
+    if (state->discard_after_cancel) {
+        state->phase = SEMANTIC_DND_PHASE_DONE;
+        return SEMANTIC_DND_ACTION_FINISH;
+    }
+    state->semantic = FALSE;
+    state->phase = SEMANTIC_DND_PHASE_TRANSFERRING;
+    return SEMANTIC_DND_ACTION_START_PAYLOAD;
+}
+
+SemanticDndProtocolAction semantic_dnd_protocol_cancel_write(
+    SemanticDndProtocolState *state, gboolean success)
+{
+    g_return_val_if_fail(state != NULL, SEMANTIC_DND_ACTION_FAIL_CLOSED);
+
+    if (state->phase != SEMANTIC_DND_PHASE_WAITING_CANCEL)
+        return SEMANTIC_DND_ACTION_NONE;
+    if (!success) {
+        state->phase = SEMANTIC_DND_PHASE_FAILED;
+        return SEMANTIC_DND_ACTION_FAIL_CLOSED;
+    }
+    state->cancel_write_complete = TRUE;
+    return cancel_barrier_action(state);
+}
+
+SemanticDndProtocolAction semantic_dnd_protocol_cancel_ack(
+    SemanticDndProtocolState *state)
+{
+    g_return_val_if_fail(state != NULL, SEMANTIC_DND_ACTION_FAIL_CLOSED);
+
+    /* Remember an early ACK, but release only after the write callback. */
+    if (state->phase != SEMANTIC_DND_PHASE_WAITING_CANCEL)
+        return SEMANTIC_DND_ACTION_NONE;
+    state->cancel_acknowledged = TRUE;
+    return cancel_barrier_action(state);
+}
+
+SemanticDndProtocolAction semantic_dnd_protocol_payload_finished(
+    SemanticDndProtocolState *state, gboolean success)
+{
+    g_return_val_if_fail(state != NULL, SEMANTIC_DND_ACTION_FAIL_CLOSED);
+
+    if (state->phase != SEMANTIC_DND_PHASE_TRANSFERRING) {
+        state->phase = SEMANTIC_DND_PHASE_FAILED;
+        return SEMANTIC_DND_ACTION_FAIL_CLOSED;
+    }
+    if (!success) {
+        if (state->semantic)
+            return semantic_dnd_protocol_begin_cancel(state, TRUE);
+        state->phase = SEMANTIC_DND_PHASE_DONE;
+        return SEMANTIC_DND_ACTION_FINISH;
+    }
+    if (state->semantic) {
+        state->payload_complete = TRUE;
+        if (!state->complete_acknowledged) {
+            state->phase = SEMANTIC_DND_PHASE_WAITING_COMPLETE;
+            return SEMANTIC_DND_ACTION_NONE;
+        }
+        state->phase = SEMANTIC_DND_PHASE_DONE;
+        return SEMANTIC_DND_ACTION_FINISH;
+    }
+    state->phase = SEMANTIC_DND_PHASE_DONE;
+    return SEMANTIC_DND_ACTION_FINISH;
+}
+
+SemanticDndProtocolAction semantic_dnd_protocol_complete(
+    SemanticDndProtocolState *state, SemanticReply reply)
+{
+    g_return_val_if_fail(state != NULL, SEMANTIC_DND_ACTION_FAIL_CLOSED);
+
+    if (state->phase != SEMANTIC_DND_PHASE_TRANSFERRING &&
+        state->phase != SEMANTIC_DND_PHASE_WAITING_COMPLETE)
+        return SEMANTIC_DND_ACTION_NONE;
+    if (reply == SEMANTIC_REPLY_UNRELATED)
+        return SEMANTIC_DND_ACTION_NONE;
+    if (reply == SEMANTIC_REPLY_COMPLETE) {
+        state->complete_acknowledged = TRUE;
+        if (state->payload_complete) {
+            state->phase = SEMANTIC_DND_PHASE_DONE;
+            return SEMANTIC_DND_ACTION_FINISH;
+        }
+        return SEMANTIC_DND_ACTION_NONE;
+    }
+    state->phase = SEMANTIC_DND_PHASE_FAILED;
+    return SEMANTIC_DND_ACTION_FAIL_CLOSED;
+}
+
+SemanticDndProtocolAction semantic_dnd_protocol_timeout(
+    SemanticDndProtocolState *state)
+{
+    g_return_val_if_fail(state != NULL, SEMANTIC_DND_ACTION_FAIL_CLOSED);
+
+    if (state->phase == SEMANTIC_DND_PHASE_WAITING_READY)
+        return semantic_dnd_protocol_begin_cancel(state, FALSE);
+    state->phase = SEMANTIC_DND_PHASE_FAILED;
+    return SEMANTIC_DND_ACTION_FAIL_CLOSED;
+}
+
+SemanticDndProtocolAction semantic_dnd_protocol_disconnect(
+    SemanticDndProtocolState *state)
+{
+    g_return_val_if_fail(state != NULL, SEMANTIC_DND_ACTION_FAIL_CLOSED);
+
+    if (!state->semantic || state->phase == SEMANTIC_DND_PHASE_DONE)
+        return SEMANTIC_DND_ACTION_NONE;
+    state->phase = SEMANTIC_DND_PHASE_FAILED;
+    return SEMANTIC_DND_ACTION_FAIL_CLOSED;
+}
+
+gboolean semantic_dnd_transform_input(gint framebuffer_width,
+                                      gint framebuffer_height,
+                                      gint display_x,
+                                      gint display_y,
+                                      gint display_width,
+                                      gint display_height,
+                                      gint scale_factor,
+                                      gdouble window_x,
+                                      gdouble window_y,
+                                      gint *input_x,
+                                      gint *input_y)
+{
+    gdouble input_scale;
+
+    if (framebuffer_width <= 0 || framebuffer_height <= 0 ||
+        display_width <= 0 || display_height <= 0 || scale_factor <= 0 ||
+        input_x == NULL || input_y == NULL)
+        return FALSE;
+
+    window_x -= display_x / scale_factor;
+    window_y -= display_y / scale_factor;
+    if (framebuffer_width == 1 || display_width == 1)
+        input_scale = 0.0;
+    else
+        input_scale = ((gdouble)(framebuffer_width - 1) /
+                       (gdouble)(display_width - 1)) * scale_factor;
+    *input_x = floor(window_x * input_scale);
+    *input_y = floor(window_y * input_scale);
+    return TRUE;
+}
