+static void test_semantic_payload_waits_for_complete(void)
+{
+    SemanticDndProtocolState state;
+
+    semantic_dnd_protocol_init(&state, TRUE);
+    g_assert_cmpint(semantic_dnd_protocol_ready(&state),
+                    ==, SEMANTIC_DND_ACTION_START_PAYLOAD);
+    g_assert_cmpint(semantic_dnd_protocol_payload_finished(&state, TRUE),
+                    ==, SEMANTIC_DND_ACTION_NONE);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_WAITING_COMPLETE);
+
+    /* This is the >=0.6 s guest stability/move window. The gate stays owned. */
+    g_assert_cmpint(semantic_dnd_protocol_complete(&state, SEMANTIC_REPLY_UNRELATED),
+                    ==, SEMANTIC_DND_ACTION_NONE);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_WAITING_COMPLETE);
+    g_assert_cmpint(semantic_dnd_protocol_complete(&state, SEMANTIC_REPLY_COMPLETE),
+                    ==, SEMANTIC_DND_ACTION_FINISH);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_DONE);
+}
+
+static void test_early_complete_still_waits_for_payload_finish(void)
+{
+    SemanticDndProtocolState state;
+
+    semantic_dnd_protocol_init(&state, TRUE);
