+static void test_complete_validation(void)
+{
+    gchar *complete = complete_message(transfer_id);
+    gchar *wrong_id = complete_message(
+        "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee");
+    gchar *extra = g_strdup_printf(
+        "{\"type\":\"complete\",\"version\":1,\"transferId\":\"%s\","
+        "\"files\":[]}", transfer_id);
+
+    g_assert_cmpint(semantic_dnd_validate_reply(complete, strlen(complete), transfer_id),
+                    ==, SEMANTIC_REPLY_COMPLETE);
+    g_assert_cmpint(semantic_dnd_validate_reply(wrong_id, strlen(wrong_id), transfer_id),
+                    ==, SEMANTIC_REPLY_UNRELATED);
+    g_assert_cmpint(semantic_dnd_validate_reply(extra, strlen(extra), transfer_id),
+                    ==, SEMANTIC_REPLY_INVALID);
+    g_free(complete);
+    g_free(wrong_id);
+    g_free(extra);
+}
