+static void test_resource_limits(void)
+{
+    gchar nested[67];
+    const gchar invalid_utf8[] = "{\"type\":\"\xff\"}";
+
+    memset(nested, '[', 33);
+    memset(nested + 33, ']', 33);
+    nested[66] = '\0';
+    g_assert_cmpint(semantic_dnd_validate_reply(nested, 66, transfer_id),
+                   ==, SEMANTIC_REPLY_INVALID);
+    g_assert_cmpint(semantic_dnd_validate_reply(invalid_utf8,
+                                              sizeof(invalid_utf8) - 1, transfer_id),
+                   ==, SEMANTIC_REPLY_INVALID);
+}
