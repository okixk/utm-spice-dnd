+#pragma once
+
+#include <glib.h>
+
+typedef enum {
+    SEMANTIC_REPLY_INVALID,
+    SEMANTIC_REPLY_UNRELATED,
+    SEMANTIC_REPLY_READY,
+    SEMANTIC_REPLY_ERROR,
+    SEMANTIC_REPLY_CANCELLED,
+    SEMANTIC_REPLY_COMPLETE,
+} SemanticReply;
+
+typedef enum {
+    SEMANTIC_DND_PHASE_WAITING_READY,
+    SEMANTIC_DND_PHASE_WAITING_CANCEL,
+    SEMANTIC_DND_PHASE_TRANSFERRING,
+    SEMANTIC_DND_PHASE_WAITING_COMPLETE,
+    SEMANTIC_DND_PHASE_DONE,
+    SEMANTIC_DND_PHASE_FAILED,
+} SemanticDndProtocolPhase;
+
+typedef enum {
+    SEMANTIC_DND_ACTION_NONE,
+    SEMANTIC_DND_ACTION_SEND_CANCEL,
+    SEMANTIC_DND_ACTION_START_PAYLOAD,
+    SEMANTIC_DND_ACTION_FINISH,
+    SEMANTIC_DND_ACTION_FAIL_CLOSED,
+} SemanticDndProtocolAction;
+
+typedef struct {
+    SemanticDndProtocolPhase phase;
+    gboolean semantic;
+    gboolean discard_after_cancel;
+    gboolean cancel_write_complete;
+    gboolean cancel_acknowledged;
+    gboolean payload_complete;
+    gboolean complete_acknowledged;
+} SemanticDndProtocolState;
+
+SemanticReply semantic_dnd_validate_reply(const gchar *line,
+                                          gsize line_length,
+                                          const gchar *transfer_id);
+
+void semantic_dnd_protocol_init(SemanticDndProtocolState *state,
+                                gboolean semantic);
+SemanticDndProtocolAction semantic_dnd_protocol_ready(
+    SemanticDndProtocolState *state);
+SemanticDndProtocolAction semantic_dnd_protocol_begin_cancel(
+    SemanticDndProtocolState *state, gboolean discard_after_cancel);
+SemanticDndProtocolAction semantic_dnd_protocol_cancel_write(
+    SemanticDndProtocolState *state, gboolean success);
+SemanticDndProtocolAction semantic_dnd_protocol_cancel_ack(
+    SemanticDndProtocolState *state);
+SemanticDndProtocolAction semantic_dnd_protocol_payload_finished(
+    SemanticDndProtocolState *state, gboolean success);
+SemanticDndProtocolAction semantic_dnd_protocol_complete(
+    SemanticDndProtocolState *state, SemanticReply reply);
+SemanticDndProtocolAction semantic_dnd_protocol_timeout(
+    SemanticDndProtocolState *state);
+SemanticDndProtocolAction semantic_dnd_protocol_disconnect(
+    SemanticDndProtocolState *state);
+
+gboolean semantic_dnd_transform_input(gint framebuffer_width,
+                                      gint framebuffer_height,
+                                      gint display_x,
+                                      gint display_y,
+                                      gint display_width,
+                                      gint display_height,
+                                      gint scale_factor,
+                                      gdouble window_x,
+                                      gdouble window_y,
+                                      gint *input_x,
+                                      gint *input_y);
