+static void test_ready_validation(void)
+{
+    gchar *ready = g_strdup_printf(
+        "{\"type\":\"ready\",\"version\":1,\"transferId\":\"%s\","
+        "\"target\":{\"kind\":\"nautilus\",\"uri\":\"file:///home/u/Documents\","
+        "\"confidence\":\"high\",\"diagnostic\":{}}}", transfer_id);
+    gchar *empty_target = g_strdup_printf(
+        "{\"type\":\"ready\",\"version\":1,\"transferId\":\"%s\","
+        "\"target\":{}}", transfer_id);
+    gchar *extra_target = g_strdup_printf(
+        "{\"type\":\"ready\",\"version\":1,\"transferId\":\"%s\","
+        "\"target\":{\"kind\":\"desktop\",\"uri\":\"file:///tmp\","
+        "\"confidence\":\"high\",\"path\":\"/tmp\"}}", transfer_id);
+
+    g_assert_cmpint(semantic_dnd_validate_reply(ready, strlen(ready), transfer_id),
+                    ==, SEMANTIC_REPLY_READY);
+    g_assert_cmpint(semantic_dnd_validate_reply(empty_target, strlen(empty_target), transfer_id),
+                    ==, SEMANTIC_REPLY_INVALID);
+    g_assert_cmpint(semantic_dnd_validate_reply(extra_target, strlen(extra_target), transfer_id),
+                    ==, SEMANTIC_REPLY_INVALID);
+    g_free(ready);
+    g_free(empty_target);
+    g_free(extra_target);
+}
+
+static void test_control_and_framing_validation(void)
+{
+    gchar *cancelled = g_strdup_printf(
+        "{\"type\":\"cancelled\",\"version\":1,\"transferId\":\"%s\"}",
+        transfer_id);
+    gchar *unrelated = g_strdup(
+        "{\"type\":\"ready\",\"version\":1,"
+        "\"transferId\":\"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee\",\"target\":{}}");
+    gchar with_nul[] = "{\"type\":\"ready\"}\0junk";
+    gchar *escaped_nul = g_strdup_printf(
+        "{\"type\":\"ready\\u0000evil\",\"version\":1,\"transferId\":\"%s\","
+        "\"target\":{\"kind\":\"desktop\",\"uri\":\"file:///tmp\","
+        "\"confidence\":\"high\"}}", transfer_id);
+
+    g_assert_cmpint(semantic_dnd_validate_reply(cancelled, strlen(cancelled), transfer_id),
+                    ==, SEMANTIC_REPLY_CANCELLED);
+    g_assert_cmpint(semantic_dnd_validate_reply(unrelated, strlen(unrelated), transfer_id),
+                    ==, SEMANTIC_REPLY_UNRELATED);
+    g_assert_cmpint(semantic_dnd_validate_reply(with_nul, sizeof(with_nul) - 1, transfer_id),
+                    ==, SEMANTIC_REPLY_INVALID);
+    g_assert_cmpint(semantic_dnd_validate_reply(escaped_nul, strlen(escaped_nul), transfer_id),
+                    ==, SEMANTIC_REPLY_INVALID);
+    g_free(cancelled);
+    g_free(unrelated);
+    g_free(escaped_nul);
+}
