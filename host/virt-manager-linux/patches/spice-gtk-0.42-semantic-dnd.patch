+static void semantic_cancel_then_start(SpiceDisplay *display, const gchar *reason)
+{
+    SemanticDndState *state = semantic_dnd_state(display, FALSE);
+    SemanticDndProtocolAction action;
+
+    if (state == NULL || state->active == NULL ||
+        state->active->protocol.phase != SEMANTIC_DND_PHASE_WAITING_READY)
+        return;
+    action = semantic_dnd_protocol_begin_cancel(&state->active->protocol, FALSE);
+    if (action == SEMANTIC_DND_ACTION_SEND_CANCEL)
+        semantic_send_cancel(display, reason);
+    else if (action == SEMANTIC_DND_ACTION_FAIL_CLOSED)
+        semantic_abort_uncertain(display, "invalid cancellation transition");
+}
+
+static gboolean semantic_metadata_timeout(gpointer user_data)
+{
+    SpiceDisplay *display = SPICE_DISPLAY(user_data);
+    SemanticDndState *state = semantic_dnd_state(display, FALSE);
+
+    if (state != NULL && state->active != NULL) {
+        SemanticDndProtocolPhase phase = state->active->protocol.phase;
+        SemanticDndProtocolAction action;
+
+        state->active->timeout_source = 0;
+        action = semantic_dnd_protocol_timeout(&state->active->protocol);
+        if (action == SEMANTIC_DND_ACTION_SEND_CANCEL)
+            semantic_send_cancel(display, "timed out");
+        else if (action == SEMANTIC_DND_ACTION_FAIL_CLOSED)
+            semantic_abort_uncertain(display,
+                phase == SEMANTIC_DND_PHASE_WAITING_COMPLETE ?
+                    "completion acknowledgement timed out" :
+                    "cancel acknowledgement timed out");
+    }
+    return G_SOURCE_REMOVE;
+}
+
+static void semantic_transfer_finished(GObject *source_object,
+                                       GAsyncResult *result,
+                                       gpointer user_data)
+{
+    SemanticTransferCompletion *completion = user_data;
+    SemanticDndState *state = semantic_dnd_state(completion->display, FALSE);
+    SemanticDndProtocolAction action = SEMANTIC_DND_ACTION_NONE;
+    GError *error = NULL;
+    gboolean success;
+
+    success = spice_main_channel_file_copy_finish(SPICE_MAIN_CHANNEL(source_object),
+                                                  result, &error);
+    if (!success) {
+        g_warning("File transfer failed with error: %s",
+                  error != NULL ? error->message : "unknown error");
+    }
+    if (state != NULL && state->active != NULL &&
+        g_str_equal(state->active->transfer_id, completion->transfer_id)) {
+        action = semantic_dnd_protocol_payload_finished(&state->active->protocol,
+                                                        success);
+        if (action == SEMANTIC_DND_ACTION_SEND_CANCEL) {
+            semantic_send_cancel(completion->display, "payload failed");
+        } else if (action == SEMANTIC_DND_ACTION_FINISH) {
+            semantic_drop_clear(completion->display);
+        } else if (action == SEMANTIC_DND_ACTION_FAIL_CLOSED) {
+            semantic_abort_uncertain(completion->display,
+                                     "invalid payload completion transition");
+        } else if (success &&
+                   state->active->protocol.phase ==
+                       SEMANTIC_DND_PHASE_WAITING_COMPLETE) {
+            state->active->timeout_source = g_timeout_add_full(
+                G_PRIORITY_DEFAULT, SEMANTIC_DND_COMPLETE_TIMEOUT_MS,
+                semantic_metadata_timeout, g_object_ref(completion->display),
+                g_object_unref);
+        }
+    }
     g_clear_error(&error);
+    g_clear_object(&completion->display);
+    g_free(completion->transfer_id);
+    g_free(completion);
+}
+
+static gboolean semantic_drop_still_valid(SemanticDrop *drop, GError **error)
+{
+    gint i;
+
+    for (i = 0; i < drop->n_files; i++) {
+        GFileInfo *info;
+        gchar *name;
+        gboolean valid;
+
+        info = g_file_query_info(drop->files[i],
+                                 G_FILE_ATTRIBUTE_STANDARD_TYPE ","
+                                 G_FILE_ATTRIBUTE_STANDARD_SIZE ","
+                                 G_FILE_ATTRIBUTE_ACCESS_CAN_READ ","
+                                 G_FILE_ATTRIBUTE_UNIX_DEVICE ","
+                                 G_FILE_ATTRIBUTE_UNIX_INODE,
+                                 G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS,
+                                 NULL, error);
+        if (info == NULL)
+            return FALSE;
+        name = g_file_get_basename(drop->files[i]);
+        valid = g_file_info_get_file_type(info) == G_FILE_TYPE_REGULAR &&
+                g_file_info_get_attribute_boolean(info,
+                                                  G_FILE_ATTRIBUTE_ACCESS_CAN_READ) &&
+                g_file_info_get_size(info) == drop->sizes[i] &&
+                g_file_info_get_attribute_uint32(info,
+                                                 G_FILE_ATTRIBUTE_UNIX_DEVICE) ==
+                    drop->devices[i] &&
+                g_file_info_get_attribute_uint64(info,
+                                                 G_FILE_ATTRIBUTE_UNIX_INODE) ==
+                    drop->inodes[i] &&
+                g_strcmp0(name, drop->names[i]) == 0;
+        g_free(name);
+        g_object_unref(info);
+        if (!valid) {
+            g_set_error(error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                        "dropped file %d changed before transfer", i + 1);
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+static void semantic_start_payload(SpiceDisplay *display)
+{
+    SemanticDndState *state = semantic_dnd_state(display, FALSE);
+    SemanticDrop *drop;
+    SemanticTransferCompletion *completion;
+    SpiceDisplayPrivate *d = display->priv;
+    GError *error = NULL;
+
+    if (state == NULL || state->active == NULL ||
+        state->active->protocol.phase != SEMANTIC_DND_PHASE_TRANSFERRING)
+        return;
+    drop = state->active;
+    if (drop->timeout_source != 0) {
+        g_source_remove(drop->timeout_source);
+        drop->timeout_source = 0;
+    }
+    if (d->main == NULL) {
+        if (drop->protocol.semantic)
+            semantic_abort_uncertain(display, "main channel unavailable after ready");
+        else
+            semantic_drop_clear(display);
+        return;
+    }
+    if (!semantic_drop_still_valid(drop, &error)) {
+        g_warning("Rejected SPICE file drop before payload transfer: %s",
+                  error != NULL ? error->message : "file changed");
+        g_clear_error(&error);
+        if (drop->protocol.semantic)
+            semantic_abort_uncertain(display, "source file changed after metadata");
+        else
+            semantic_drop_clear(display);
+        return;
+    }
+
+    completion = g_new0(SemanticTransferCompletion, 1);
+    completion->display = g_object_ref(display);
+    completion->transfer_id = g_strdup(drop->transfer_id);
+    spice_main_channel_file_copy_async(d->main,
+                                       drop->files,
+                                       0,
+                                       drop->cancellable,
+                                       NULL,
+                                       NULL,
+                                       semantic_transfer_finished,
+                                       completion);
+}
+
+static void semantic_handle_reply(SpiceDisplay *display,
+                                  const gchar *line,
+                                  gsize line_length)
+{
+    SemanticDndState *state = semantic_dnd_state(display, FALSE);
+    SemanticReply reply;
+
+    if (state == NULL || state->active == NULL)
+        return;
+    reply = semantic_dnd_validate_reply(line, line_length,
+                                        state->active->transfer_id);
+    if (reply == SEMANTIC_REPLY_UNRELATED)
+        return;
+    if (state->active->protocol.phase == SEMANTIC_DND_PHASE_WAITING_CANCEL) {
+        if (reply == SEMANTIC_REPLY_CANCELLED) {
+            SemanticDndProtocolAction action;
+
+            DISPLAY_DEBUG(display, "semantic DnD cancellation acknowledged id=%s",
+                          state->active->transfer_id);
+            action = semantic_dnd_protocol_cancel_ack(&state->active->protocol);
+            if (action == SEMANTIC_DND_ACTION_FINISH)
+                semantic_drop_clear(display);
+            else if (action == SEMANTIC_DND_ACTION_START_PAYLOAD)
+                semantic_start_payload(display);
+        }
+        return;
+    }
+    if (state->active->protocol.phase == SEMANTIC_DND_PHASE_TRANSFERRING ||
+        state->active->protocol.phase == SEMANTIC_DND_PHASE_WAITING_COMPLETE) {
+        SemanticDndProtocolAction action =
+            semantic_dnd_protocol_complete(&state->active->protocol, reply);
+
+        if (action == SEMANTIC_DND_ACTION_FINISH)
+            semantic_drop_clear(display);
+        else if (action == SEMANTIC_DND_ACTION_FAIL_CLOSED)
+            semantic_abort_uncertain(display,
+                                     "received an invalid completion response");
+        return;
+    }
+    if (reply == SEMANTIC_REPLY_READY) {
+        SemanticDndProtocolAction action =
+            semantic_dnd_protocol_ready(&state->active->protocol);
+
+        DISPLAY_DEBUG(display, "semantic DnD ready id=%s",
+                      state->active->transfer_id);
+        if (action == SEMANTIC_DND_ACTION_START_PAYLOAD)
+            semantic_start_payload(display);
+        else
+            semantic_abort_uncertain(display, "invalid ready transition");
+    } else if (reply == SEMANTIC_REPLY_ERROR) {
+        semantic_cancel_then_start(display, "was rejected by the guest");
+    } else {
+        semantic_cancel_then_start(display, "received a malformed response");
+    }
+}
+
+static void semantic_port_data(SpicePortChannel *port,
+                               gpointer data,
+                               gint size,
+                               SpiceDisplay *display)
+{
+    SemanticDndState *state = semantic_dnd_state(display, FALSE);
+    guint8 *newline;
+
+    if (state == NULL || state->port != port || size <= 0)
+        return;
+    if ((gsize)size > SEMANTIC_DND_MAX_MESSAGE_BYTES - state->read_buffer->len) {
+        g_byte_array_set_size(state->read_buffer, 0);
+        semantic_cancel_then_start(display, "received an oversized response");
+        return;
+    }
+    g_byte_array_append(state->read_buffer, data, size);
+    while ((newline = memchr(state->read_buffer->data, '\n',
+                             state->read_buffer->len)) != NULL) {
+        gsize line_length = newline - state->read_buffer->data;
+        gchar *line;
+
+        if (line_length + 1 > SEMANTIC_DND_MAX_MESSAGE_BYTES) {
+            g_byte_array_remove_range(state->read_buffer, 0, line_length + 1);
+            semantic_cancel_then_start(display, "received an oversized response");
+            continue;
+        }
+        line = g_strndup((const gchar *)state->read_buffer->data, line_length);
+        g_byte_array_remove_range(state->read_buffer, 0, line_length + 1);
+        semantic_handle_reply(display, line, line_length);
+        g_free(line);
+    }
+    if (state->read_buffer->len >= SEMANTIC_DND_MAX_MESSAGE_BYTES) {
+        g_byte_array_set_size(state->read_buffer, 0);
+        semantic_cancel_then_start(display, "received an oversized response");
+    }
+}
