+static void test_cancel_barrier_requires_write_and_ack(void)
+{
+    SemanticDndProtocolState state;
+
+    semantic_dnd_protocol_init(&state, TRUE);
+    g_assert_cmpint(semantic_dnd_protocol_begin_cancel(&state, FALSE),
+                    ==, SEMANTIC_DND_ACTION_SEND_CANCEL);
+
+    /* A pre-sent acknowledgement cannot release the fallback payload. */
+    g_assert_cmpint(semantic_dnd_protocol_cancel_ack(&state),
+                    ==, SEMANTIC_DND_ACTION_NONE);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_WAITING_CANCEL);
+    g_assert_true(state.cancel_acknowledged);
+    g_assert_cmpint(semantic_dnd_protocol_cancel_write(&state, TRUE),
+                    ==, SEMANTIC_DND_ACTION_START_PAYLOAD);
+    g_assert_true(state.cancel_write_complete);
+    g_assert_false(state.semantic);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_TRANSFERRING);
+
+    semantic_dnd_protocol_init(&state, TRUE);
+    semantic_dnd_protocol_begin_cancel(&state, FALSE);
+    g_assert_cmpint(semantic_dnd_protocol_cancel_write(&state, TRUE),
+                    ==, SEMANTIC_DND_ACTION_NONE);
+    g_assert_cmpint(semantic_dnd_protocol_cancel_ack(&state),
+                    ==, SEMANTIC_DND_ACTION_START_PAYLOAD);
+}
+
+static void test_cancel_write_failure_fails_closed(void)
+{
+    SemanticDndProtocolState state;
+
+    semantic_dnd_protocol_init(&state, TRUE);
+    semantic_dnd_protocol_begin_cancel(&state, FALSE);
+    g_assert_cmpint(semantic_dnd_protocol_cancel_ack(&state),
+                    ==, SEMANTIC_DND_ACTION_NONE);
+    g_assert_cmpint(semantic_dnd_protocol_cancel_write(&state, FALSE),
+                    ==, SEMANTIC_DND_ACTION_FAIL_CLOSED);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_FAILED);
+}
+
+static void test_payload_failure_cancel_barrier_discards(void)
+{
+    SemanticDndProtocolState state;
+
+    semantic_dnd_protocol_init(&state, TRUE);
+    semantic_dnd_protocol_ready(&state);
+    g_assert_cmpint(semantic_dnd_protocol_payload_finished(&state, FALSE),
+                    ==, SEMANTIC_DND_ACTION_SEND_CANCEL);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_WAITING_CANCEL);
+    g_assert_cmpint(semantic_dnd_protocol_cancel_ack(&state),
+                    ==, SEMANTIC_DND_ACTION_NONE);
+    g_assert_true(state.cancel_acknowledged);
+    g_assert_cmpint(semantic_dnd_protocol_cancel_write(&state, TRUE),
+                    ==, SEMANTIC_DND_ACTION_FINISH);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_DONE);
+}
