+
+    semantic_dnd_protocol_init(&state, TRUE);
+    g_assert_cmpint(semantic_dnd_protocol_timeout(&state),
+                    ==, SEMANTIC_DND_ACTION_SEND_CANCEL);
+    g_assert_cmpint(state.phase, ==, SEMANTIC_DND_PHASE_WAITING_CANCEL);
+    g_assert_cmpint(semantic_dnd_protocol_cancel_write(&state, TRUE),
