+static void semantic_drop_free(SemanticDrop *drop)
+{
+    gint i;
+
+    if (drop == NULL)
+        return;
+    if (drop->timeout_source != 0)
+        g_source_remove(drop->timeout_source);
+    if (drop->cancellable != NULL)
+        g_cancellable_cancel(drop->cancellable);
+    for (i = 0; i < drop->n_files; i++) {
+        g_clear_object(&drop->files[i]);
+        g_clear_pointer(&drop->names[i], g_free);
+    }
+    g_clear_object(&drop->cancellable);
+    g_free(drop->files);
+    g_free(drop->names);
+    g_free(drop->sizes);
+    g_free(drop->devices);
+    g_free(drop->inodes);
+    g_free(drop->transfer_id);
+    g_free(drop);
+}
+
+static void semantic_dnd_state_free(gpointer data)
+{
+    SemanticDndState *state = data;
+
+    if (state == NULL)
+        return;
+    if (state->gate->owner == state) {
+        state->gate->owner = NULL;
+        state->gate->poisoned = TRUE;
+    }
+    semantic_drop_free(state->active);
+    g_clear_pointer(&state->read_buffer, g_byte_array_unref);
+    g_clear_object(&state->session);
+    g_free(state);
+}
+
+static SemanticDndState *semantic_dnd_state(SpiceDisplay *display, gboolean create)
+{
+    GObject *object = G_OBJECT(display);
+    GQuark quark = semantic_dnd_state_quark();
+    SemanticDndState *state = g_object_get_qdata(object, quark);
+
+    if (state == NULL && create) {
+        state = g_new0(SemanticDndState, 1);
+        state->session = g_object_ref(display->priv->session);
+        state->gate = g_object_get_data(G_OBJECT(state->session), "semantic-dnd-gate");
+        if (state->gate == NULL) {
+            state->gate = g_new0(SemanticSessionGate, 1);
+            g_object_set_data_full(G_OBJECT(state->session), "semantic-dnd-gate",
+                                   state->gate, g_free);
+        }
+        state->read_buffer = g_byte_array_new();
+        g_object_set_qdata_full(object, quark, state, semantic_dnd_state_free);
+    }
+    return state;
+}
+
+static void semantic_dnd_dispose(SpiceDisplay *display)
+{
+    GObject *object = G_OBJECT(display);
+    GQuark quark = semantic_dnd_state_quark();
+
+    g_object_set_qdata_full(object, quark, NULL, NULL);
+}
+
+static void semantic_drop_clear(SpiceDisplay *display)
+{
+    SemanticDndState *state = semantic_dnd_state(display, FALSE);
+
+    if (state == NULL)
+        return;
+    semantic_drop_free(state->active);
+    state->active = NULL;
+    if (state->gate->owner == state)
+        state->gate->owner = NULL;
+}
+
+/* A transport write completion does not acknowledge guest processing. Do not
+ * release payload if the guest may still have a destination armed. Resetting
+ * the client port likewise cannot prove that its guest consumer cleared it. */
+static void semantic_abort_uncertain(SpiceDisplay *display, const gchar *reason)
+{
+    SemanticDndState *state = semantic_dnd_state(display, FALSE);
+
+    if (state == NULL || state->active == NULL)
+        return;
+    state->gate->poisoned = TRUE;
+    g_warning("Semantic DnD stopped: %s; reconnect the viewer and restart the "
+              "guest helper before retrying", reason);
+    semantic_drop_clear(display);
+}
+
+static gboolean semantic_file_name_valid(const gchar *name)
+{
+    return name != NULL && name[0] != '\0' &&
+           g_utf8_validate(name, -1, NULL) && strlen(name) <= 255 &&
+           !g_str_equal(name, ".") && !g_str_equal(name, "..") &&
+           strchr(name, '/') == NULL;
+}
+
+static SemanticDrop *semantic_drop_new(gchar **file_urls, GError **error)
+{
+    SemanticDrop *drop;
+    gint i;
+    gint n_files = g_strv_length(file_urls);
+
+    if (n_files < 1 || n_files > SEMANTIC_DND_MAX_FILES) {
+        g_set_error(error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                    "a drop must contain between 1 and %d files",
+                    SEMANTIC_DND_MAX_FILES);
+        return NULL;
+    }
+
+    drop = g_new0(SemanticDrop, 1);
+    drop->n_files = n_files;
+    drop->files = g_new0(GFile *, n_files + 1);
+    drop->names = g_new0(gchar *, n_files + 1);
+    drop->sizes = g_new0(gint64, n_files);
+    drop->devices = g_new0(guint64, n_files);
+    drop->inodes = g_new0(guint64, n_files);
+    drop->transfer_id = g_uuid_string_random();
+    drop->cancellable = g_cancellable_new();
+    for (i = 0; i < n_files; i++) {
+        GFileInfo *info;
+        gchar *path;
+        gchar *name;
+
+        drop->files[i] = g_file_new_for_uri(file_urls[i]);
+        path = g_file_get_path(drop->files[i]);
+        if (path == NULL) {
+            g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+                                "only local files can be transferred");
+            semantic_drop_free(drop);
+            return NULL;
+        }
+        g_free(path);
+
+        info = g_file_query_info(drop->files[i],
+                                 G_FILE_ATTRIBUTE_STANDARD_TYPE ","
+                                 G_FILE_ATTRIBUTE_STANDARD_SIZE ","
+                                 G_FILE_ATTRIBUTE_ACCESS_CAN_READ ","
+                                 G_FILE_ATTRIBUTE_UNIX_DEVICE ","
+                                 G_FILE_ATTRIBUTE_UNIX_INODE,
+                                 G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS,
+                                 NULL, error);
+        if (info == NULL) {
+            semantic_drop_free(drop);
+            return NULL;
+        }
+        name = g_file_get_basename(drop->files[i]);
+        if (g_file_info_get_file_type(info) != G_FILE_TYPE_REGULAR ||
+            !g_file_info_get_attribute_boolean(info, G_FILE_ATTRIBUTE_ACCESS_CAN_READ) ||
+            !semantic_file_name_valid(name) ||
+            g_file_info_get_size(info) > G_MAXINT64) {
+            g_set_error(error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                        "dropped item %d is not a readable regular file with a valid name",
+                        i + 1);
+            g_free(name);
+            g_object_unref(info);
+            semantic_drop_free(drop);
+            return NULL;
+        }
+        drop->names[i] = name;
+        drop->sizes[i] = (gint64)g_file_info_get_size(info);
+        drop->devices[i] = g_file_info_get_attribute_uint32(info,
+                                                            G_FILE_ATTRIBUTE_UNIX_DEVICE);
+        drop->inodes[i] = g_file_info_get_attribute_uint64(info,
+                                                           G_FILE_ATTRIBUTE_UNIX_INODE);
+        g_object_unref(info);
+    }
+    return drop;
+}
+
+static gchar *semantic_drop_message(SpiceDisplay *display,
+                                    SemanticDrop *drop,
+                                    gint x,
+                                    gint y,
+                                    GError **error)
+{
+    SpiceDisplayPrivate *d = display->priv;
+    JsonBuilder *builder;
+    JsonGenerator *generator;
+    JsonNode *root;
+    gchar *json;
+    gchar *frame;
+    gint i;
+    gint display_id = get_display_id(display);
+
+    if (display_id < 0 || display_id > 31 || x < 0 || y < 0 ||
+        x >= d->area.width || y >= d->area.height ||
+        d->area.width <= 0 || d->area.height <= 0) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                            "drop coordinates are outside the framebuffer");
+        return NULL;
+    }
+
+    builder = json_builder_new();
+    json_builder_begin_object(builder);
+    json_builder_set_member_name(builder, "type");
+    json_builder_add_string_value(builder, "drop");
+    json_builder_set_member_name(builder, "version");
+    json_builder_add_int_value(builder, SEMANTIC_DND_PROTOCOL_VERSION);
+    json_builder_set_member_name(builder, "transferId");
+    json_builder_add_string_value(builder, drop->transfer_id);
+    json_builder_set_member_name(builder, "display");
+    json_builder_add_int_value(builder, display_id);
+    json_builder_set_member_name(builder, "x");
+    json_builder_add_int_value(builder, x);
+    json_builder_set_member_name(builder, "y");
+    json_builder_add_int_value(builder, y);
+    json_builder_set_member_name(builder, "framebufferWidth");
+    json_builder_add_int_value(builder, d->area.width);
+    json_builder_set_member_name(builder, "framebufferHeight");
+    json_builder_add_int_value(builder, d->area.height);
+    json_builder_set_member_name(builder, "files");
+    json_builder_begin_array(builder);
+    for (i = 0; i < drop->n_files; i++) {
+        json_builder_begin_object(builder);
+        json_builder_set_member_name(builder, "name");
+        json_builder_add_string_value(builder, drop->names[i]);
+        json_builder_set_member_name(builder, "size");
+        json_builder_add_int_value(builder, drop->sizes[i]);
+        json_builder_end_object(builder);
+    }
+    json_builder_end_array(builder);
+    json_builder_end_object(builder);
+
+    root = json_builder_get_root(builder);
+    generator = json_generator_new();
+    json_generator_set_root(generator, root);
+    json = json_generator_to_data(generator, NULL);
+    frame = g_strconcat(json, "\n", NULL);
+    if (strlen(frame) > SEMANTIC_DND_MAX_MESSAGE_BYTES) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_MESSAGE_TOO_LARGE,
+                            "drop metadata exceeds 64 KiB");
+        g_clear_pointer(&frame, g_free);
+    }
+    g_free(json);
+    g_object_unref(generator);
+    json_node_free(root);
+    g_object_unref(builder);
+    return frame;
+}
