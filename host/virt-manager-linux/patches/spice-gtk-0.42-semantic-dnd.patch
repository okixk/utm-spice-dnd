+static void test_strict_json(void)
+{
+    const gchar *formats[] = {
+        "{\"type\":\"error\",\"type\":\"cancelled\",\"version\":1,\"transferId\":\"%s\"}",
+        "{\"type\":\"error\",\"ty\\u0070e\":\"cancelled\",\"version\":1,\"transferId\":\"%s\"}",
+        "{\"type\":\"cancelled\",\"version\":1.0,\"transferId\":\"%s\"}",
+        "{\"type\":\"cancelled\",\"version\":true,\"transferId\":\"%s\"}",
+        "{\"type\":\"ready\",\"version\":1,\"transferId\":\"%s\",\"target\":{\"kind\":\"desktop\",\"uri\":\"file:///tmp\",\"confidence\":\"high\",\"diagnostic\":{\"x\":1,\"x\":2}}}"
+    };
+    guint i;
+    gchar *large = g_malloc0(65537);
+    gchar *cancelled = g_strdup_printf(
+        "{\"type\":\"cancelled\",\"version\":1,\"transferId\":\"%s\"}", transfer_id);
+
+    for (i = 0; i < G_N_ELEMENTS(formats); i++) {
+        gchar *message = g_strdup_printf(formats[i], transfer_id);
+        g_assert_cmpint(semantic_dnd_validate_reply(message, strlen(message), transfer_id),
+                       ==, SEMANTIC_REPLY_INVALID);
+        g_free(message);
+    }
+    memset(large, ' ', 65536);
+    memcpy(large, cancelled, strlen(cancelled));
+    g_assert_cmpint(semantic_dnd_validate_reply(large, 65536, transfer_id),
+                   ==, SEMANTIC_REPLY_INVALID);
+    g_assert_cmpint(semantic_dnd_validate_reply(large, 65535, transfer_id),
+                   ==, SEMANTIC_REPLY_CANCELLED);
+    g_free(cancelled);
+    g_free(large);
+}
