[Unit]
Description=Target-aware SPICE drag-and-drop guest helper
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/libexec/utm-dnd-guest
Restart=on-failure
RestartSec=1
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
